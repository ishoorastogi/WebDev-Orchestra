# Supabase project URL (public project identifier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (safe to expose to the browser; never use a secret/service_role key here)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Canonical site origin used to send password reset emails (optional in local development)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
